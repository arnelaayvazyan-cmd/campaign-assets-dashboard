# Admin login (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long random string used to sign the login cookie (recommended)
SESSION_SECRET=replace-with-a-long-random-string

# Set to "false" to make the whole dashboard private (login required to view)
PUBLIC_VIEW=true

# Storage — filled in automatically when you connect Upstash Redis in Vercel
# (Vercel → Storage → Marketplace → Upstash → Redis). Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
